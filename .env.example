# Copy of .env.local with the values left blank. Safe to commit.
# Supabase › Connect › App Frameworks › Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Anthropic › platform.claude.com/settings/keys (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=
# Which Claude models to use (not secret)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5-5
# TinyFish › agent.tinyfish.ai/api-keys (server only)
TINYFISH_API_KEY=
