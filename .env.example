# Copy of .env.local with the values left blank. Safe to commit.
# Supabase › Connect › App Frameworks › Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Anthropic › platform.claude.com/settings/keys (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=
# Which Claude models to use (not secret)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_JUDGE_MODEL=claude-sonnet-5-5
# One-off calibration reviews (scripts/calibrate.ts), not used in searches
ANTHROPIC_REVIEW_MODEL=claude-fable-5-2
# TinyFish › agent.tinyfish.ai/api-keys (server only)
TINYFISH_API_KEY=
# Supabase › Project Settings › API Keys › Secret keys (sb_secret_…, server only, never NEXT_PUBLIC)
SUPABASE_SECRET_KEY=
# SerpApi › serpapi.com/dashboard (server only)
SERPAPI_API_KEY=
# Inngest: on Vercel the Inngest integration sets INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY.
# On a Mac, run searches through the local Inngest Dev Server instead:
INNGEST_DEV=1
